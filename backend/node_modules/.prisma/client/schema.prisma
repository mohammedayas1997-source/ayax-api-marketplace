generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PackageTier {
  REGULAR
  STANDARD
  PREMIUM
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  phone               String?
  password            String
  role                UserRole   @default(CUSTOMER)
  status              UserStatus @default(ACTIVE)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  passwordChangedAt   DateTime?

  passwordResetTokens PasswordResetToken[]
  revokedTokens       RevokedToken[]

  activityLogs    ActivityLog[]
  apiKeys         ApiKey[]
  apiUsages       ApiUsage[]
  fundingRequests FundingRequest[]
  loginHistory    LoginHistory[]

  refundRequests RefundRequest[]
  securityLogs   SecurityLog[]
  supportTickets SupportTicket[]
  transactions   Transaction[]

  wallet            Wallet?
  walletFundings    WalletFunding[]
  walletLedgers     WalletLedger[]
  walletWithdrawals WalletWithdrawal[]

  webhooks Webhook[]

  notifications        Notification[] @relation("UserNotifications")
  createdNotifications Notification[] @relation("NotificationCreator")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model RevokedToken {
  id        String   @id @default(cuid())
  userId    String
  tokenId   String   @unique
  expiresAt DateTime
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id                 String         @id @default(cuid())
  userId             String
  name               String         @default("Live API Key")
  key                String         @unique
  keyPrefix          String?
  status             ApiKeyStatus   @default(ACTIVE)
  environment        ApiEnvironment @default(PRODUCTION)
  scopes             ApiScope[]     @default([DATA, AIRTIME, ELECTRICITY, CABLE, BVN, NIN])
  rateLimitPerMinute Int            @default(100)
  rateLimitPerDay    Int            @default(10000)
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages ApiUsage[]

  @@index([userId, status])
  @@index([environment, status])
  @@index([expiresAt])
  @@index([lastUsedAt])
}

model Transaction {
  id          String            @id @default(cuid())
  reference   String            @unique
  userId      String
  type        TransactionType
  service     String?
  amount      Float
  status      TransactionStatus @default(PENDING)
  description String?
  retryCount  Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FundingRequest {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  status    String   @default("PENDING")
  reference String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletFunding {
  id               String        @id @default(cuid())
  userId           String
  amount           Float
  reference        String        @unique
  channel          String?
  proofUrl         String?
  status           FundingStatus @default(PENDING)
  approvedBy       String?
  rejectedBy       String?
  note             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  approvedAt       DateTime?
  rejectedAt       DateTime?
  paymentReference String?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletWithdrawal {
  id            String           @id @default(cuid())
  userId        String
  amount        Float
  reference     String           @unique
  bankName      String?
  accountName   String?
  accountNumber String?
  status        WithdrawalStatus @default(PENDING)
  approvedBy    String?
  rejectedBy    String?
  paidBy        String?
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  approvedAt    DateTime?
  rejectedAt    DateTime?
  paidAt        DateTime?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletLedger {
  id            String     @id @default(cuid())
  userId        String
  reference     String     @unique
  type          LedgerType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  description   String?
  module        String?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefundRequest {
  id            String       @id @default(cuid())
  transactionId String
  userId        String
  amount        Float
  reason        String?
  status        RefundStatus @default(PENDING)
  adminPinUsed  Boolean      @default(false)
  approvedBy    String?
  rejectedBy    String?
  rejectionNote String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  approvedAt    DateTime?
  rejectedAt    DateTime?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String
  subject    String
  message    String
  status     String   @default("OPEN")
  priority   String   @default("NORMAL")
  assignedTo String?
  escalated  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiProvider {
  id                String                  @id @default(cuid())
  name              String
  slug              String                  @unique
  baseUrl           String?
  apiKey            String?
  secretKey         String?
  status            ProviderStatus          @default(ACTIVE)
  description       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  category          ProviderCategory        @default(OTHER)
  code              String                  @unique
  failureCount      Int                     @default(0)
  isFallback        Boolean                 @default(false)
  lastFailureAt     DateTime?
  lastHealthCheckAt DateTime?
  lastSuccessAt     DateTime?
  password          String?
  priority          Int                     @default(1)
  successCount      Int                     @default(0)
  timeoutMs         Int                     @default(30000)
  username          String?
  webhookUrl        String?
  credentials       ApiProviderCredential[]
  services          ApiService[]

  @@index([category, status])
  @@index([priority])
  @@index([isFallback])
}

model ApiProviderCredential {
  id                   String         @id @default(cuid())
  providerId           String
  name                 String
  type                 CredentialType @default(CUSTOM)
  encryptedValue       String
  initializationVector String
  authenticationTag    String?
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  provider             ApiProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, name])
  @@index([providerId, active])
}

model ApiService {
  id                  String        @id @default(cuid())
  providerId          String
  name                String
  slug                String        @unique
  category            String
  endpoint            String
  method              String        @default("POST")
  status              ServiceStatus @default(ACTIVE)
  description         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  code                String        @unique
  metadata            Json?
  providerServiceCode String?
  requestMapping      Json?
  responseMapping     Json?
  plans               ApiPlan[]
  provider            ApiProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
  @@index([category, status])
}

model ApiPlan {
  id           String     @id @default(cuid())
  serviceId    String
  name         String
  code         String     @unique
  category     String
  costPrice    Float
  sellingPrice Float
  status       PlanStatus @default(ACTIVE)
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  features     Json?
  metadata     Json?
  packageType  String     @default("REGULAR")
  service      ApiService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, status])
  @@index([category, packageType])
}

model ServicePricing {
  id String @id @default(cuid())

  serviceCode String
  serviceName String
  category    String
  tier        PackageTier

  costPrice    Float   @default(0)
  sellingPrice Float
  currency     String  @default("NGN")
  enabled      Boolean @default(true)

  features Json?
  metadata Json?

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceCode, tier])
  @@index([category, enabled])
  @@index([serviceCode, enabled])
}

model GsmTransaction {
  id          String               @id @default(cuid())
  simId       String
  phoneNumber String
  network     String
  amount      Float
  reference   String               @unique
  status      GsmTransactionStatus @default(PENDING)
  response    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  sim         GsmSim               @relation(fields: [simId], references: [id], onDelete: Cascade)
}

model GsmRecharge {
  id        String            @id @default(cuid())
  simId     String
  amount    Float
  reference String            @unique
  status    GsmRechargeStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  sim       GsmSim            @relation(fields: [simId], references: [id], onDelete: Cascade)
}

model GsmHealthLog {
  id          String          @id @default(cuid())
  simId       String
  signal      Int?
  battery     Int?
  temperature Float?
  status      GsmHealthStatus @default(HEALTHY)
  message     String?
  createdAt   DateTime        @default(now())
  sim         GsmSim          @relation(fields: [simId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?
  action      String
  module      String
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id      String @id @default(cuid())
  batchId String

  userId String

  title   String
  message String

  type     String @default("INFO")
  priority String @default("NORMAL")
  audience String @default("USER")

  targetRole UserRole?

  actionText String?
  actionUrl  String?
  imageUrl   String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdById    String?
  createdByName  String?
  createdByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("NotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([batchId])
  @@index([createdById])
  @@index([type])
  @@index([audience])
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  browser    String?
  os         String?
  device     String?
  successful Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String       @id @default(cuid())
  userId      String
  type        ActivityType
  module      String
  description String?
  ipAddress   String?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityLog {
  id          String            @id @default(cuid())
  userId      String
  event       SecurityEventType
  ipAddress   String?
  description String?
  successful  Boolean           @default(true)
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiUsage {
  id             String         @id @default(cuid())
  userId         String
  apiKeyId       String?
  endpoint       String
  method         String
  service        String?
  reference      String?
  amount         Float          @default(0)
  status         ApiUsageStatus @default(PROCESSING)
  httpStatusCode Int?
  errorCode      String?
  errorMessage   String?
  requestBody    String?
  responseBody   String?
  ipAddress      String?
  userAgent      String?
  latency        Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([status, createdAt])
  @@index([service, createdAt])
  @@index([reference])
}

model Webhook {
  id        String        @id @default(cuid())
  userId    String
  name      String
  url       String
  secret    String?
  status    WebhookStatus @default(ACTIVE)
  events    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiDocumentation {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  category  String?
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QueueJob {
  id        String         @id @default(cuid())
  name      String
  queue     String
  payload   String?
  status    QueueJobStatus @default(WAITING)
  attempts  Int            @default(0)
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Backup {
  id          String       @id @default(cuid())
  name        String
  fileUrl     String?
  size        String?
  status      BackupStatus @default(PENDING)
  error       String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?
}

model ServerHealth {
  id          String   @id @default(cuid())
  cpuUsage    Float?
  memoryUsage Float?
  diskUsage   Float?
  apiLatency  Int?
  status      String   @default("HEALTHY")
  message     String?
  createdAt   DateTime @default(now())
}

model RedisMonitor {
  id        String   @id @default(cuid())
  status    String   @default("CONNECTED")
  memory    String?
  keys      Int?
  uptime    String?
  message   String?
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String        @id @default(cuid())
  to        String
  subject   String
  body      String?
  status    MessageStatus @default(PENDING)
  error     String?
  createdAt DateTime      @default(now())
  sentAt    DateTime?
}

model SmsLog {
  id        String        @id @default(cuid())
  phone     String
  message   String
  status    MessageStatus @default(PENDING)
  error     String?
  createdAt DateTime      @default(now())
  sentAt    DateTime?
}

model PaymentGateway {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  publicKey String?
  secretKey String?
  baseUrl   String?
  status    PaymentGatewayStatus @default(TEST)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model CompanySetting {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  website   String?
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  symbol    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Country {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  currency  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GsmDevice {
  id             String                 @id @default(cuid())
  name           String
  code           String                 @unique
  secretKey      String
  location       String?
  status         GsmDeviceStatus        @default(OFFLINE)
  battery        Int?
  charging       Boolean?
  signal         Int?
  internet       Boolean?
  lastSeen       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  accuracy       Float?
  bearing        Float?
  latitude       Float?
  locationAt     DateTime?
  longitude      Float?
  speed          Float?
  securityAlerts GatewaySecurityAlert[]
  commands       GsmCommand[]
  sims           GsmSim[]
  smsInbox       SmsInbox[]
}

model GsmCommand {
  id          String           @id @default(cuid())
  reference   String           @unique
  deviceId    String?
  type        GsmCommandType
  status      GsmCommandStatus @default(PENDING)
  response    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?
  payload     Json?
  device      GsmDevice?       @relation(fields: [deviceId], references: [id])
}

model GatewayDevice {
  id             String    @id @default(cuid())
  pairCode       String    @unique
  token          String    @unique
  deviceName     String
  brand          String
  model          String
  uniqueId       String    @unique
  androidVersion String?
  manufacturer   String?
  batteryLevel   Int       @default(0)
  signalLevel    Int       @default(0)
  simCount       Int       @default(0)
  ipAddress      String?
  appVersion     String?
  socketId       String?
  status         String    @default("OFFLINE")
  lastSeen       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model GsmPairCode {
  id        String     @id @default(cuid())
  code      String     @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  status    PairStatus @default(PENDING)
}

model SmsInbox {
  id          String    @id @default(cuid())
  deviceId    String
  phoneNumber String
  message     String
  createdAt   DateTime  @default(now())
  device      GsmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model SimRoutingRule {
  id           String   @id @default(cuid())
  network      String
  service      String
  preferredSim Int
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GsmSim {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  airtimeBalance   Float            @default(0)
  carrierName      String?
  countryIso       String?
  dataBalance      String?
  deviceId         String
  displayName      String?
  lastSyncAt       DateTime         @default(now())
  mcc              Int?
  mnc              Int?
  phoneNumber      String?
  slotIndex        Int
  status           String           @default("ACTIVE")
  expiryDate       DateTime?
  lastBalanceCheck DateTime?
  GsmHealthLog     GsmHealthLog[]
  GsmRecharge      GsmRecharge[]
  device           GsmDevice        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  GsmTransaction   GsmTransaction[]

  @@unique([deviceId, slotIndex])
}

model NetworkProfile {
  id               String   @id @default(cuid())
  network          String   @unique
  displayName      String
  enabled          Boolean  @default(true)
  airtimeTemplate  String?
  dataTemplate     String?
  rechargeTemplate String?
  defaultSimSlot   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  balanceUssd      String?
  country          String   @default("NG")
  dataBalanceUssd  String?
  notes            String?
}

model GatewaySecurityAlert {
  id        String    @id @default(cuid())
  deviceId  String
  type      String
  message   String
  resolved  Boolean   @default(false)
  createdAt DateTime  @default(now())
  device    GsmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF_ADMIN
  CUSTOMER_SERVICE
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  REVERSAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
}

enum FundingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LedgerType {
  CREDIT
  DEBIT
  REFUND
  REVERSAL
  ADJUSTMENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityType {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  API_CALL
  WALLET
  SYSTEM
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET
  TWO_FACTOR_ENABLED
  ACCOUNT_LOCKED
  API_KEY_CREATED
  API_KEY_REVOKED
}

enum GsmSimStatus {
  ACTIVE
  INACTIVE
  BUSY
  ERROR
  BLOCKED
}

enum GsmTransactionStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
}

enum GsmRechargeStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum GsmHealthStatus {
  HEALTHY
  WARNING
  CRITICAL
}

enum QueueJobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentGatewayStatus {
  ACTIVE
  DISABLED
  TEST
}

enum ProviderStatus {
  ACTIVE
  DISABLED
  MAINTENANCE
}

enum ProviderCategory {
  GSM
  IDENTITY
  UTILITY
  FINANCE
  AI
  EDUCATION
  OTHER
}

enum CredentialType {
  API_KEY
  SECRET_KEY
  USERNAME
  PASSWORD
  TOKEN
  CLIENT_ID
  CLIENT_SECRET
  MERCHANT_ID
  PUBLIC_KEY
  PRIVATE_KEY
  CUSTOM
}

enum ServiceStatus {
  ACTIVE
  DISABLED
  MAINTENANCE
}

enum PlanStatus {
  ACTIVE
  DISABLED
}

enum ApiUsageStatus {
  SUCCESSFUL
  FAILED
  PROCESSING
}

enum WebhookStatus {
  ACTIVE
  DISABLED
}

enum GsmDeviceStatus {
  ONLINE
  OFFLINE
  BUSY
  ERROR
}

enum GsmCommandStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
}

enum GsmCommandType {
  BUY_AIRTIME
  BUY_DATA
  CHECK_BALANCE
  SEND_SMS
  READ_SMS
  USSD
  LOCK_DEVICE
  UNLOCK_DEVICE
  START_ALARM
  STOP_ALARM
  GET_LOCATION
